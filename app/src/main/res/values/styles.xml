<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/window_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- Android 11 has no system splash, so the compat library draws this one there -->
    <style name="Theme.Sift.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">@integer/splash_duration</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
